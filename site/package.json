{
	"name": "site",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"verify:bundles": "node --experimental-strip-types util/app-bundle-size/verify.ts",
		"build:client": "tsc && vite build --ssrManifest .vite/ssr-manifest.json --outDir dist/static",
		"build:server": "tsc && vite build --ssr src/main-server.ts --outDir dist/server",
		"build": "pnpm run build:client && pnpm run build:server && node prerender.js"
	},
	"devDependencies": {
		"@babel/core": "^8.0.1",
		"@mdx-js/mdx": "^3.1.1",
		"@mdx-js/rollup": "^3.1.1",
		"@types/estree-jsx": "^1.0.5",
		"@wooorm/starry-night": "^3.10.0",
		"babel-preset-solid": "^1.9.15",
		"esbuild": "^0.28.1",
		"estree-util-visit": "^2.0.0",
		"happy-dom": "^20.10.6",
		"preact": "^10.29.8",
		"rehype-starry-night": "^2.2.0",
		"remark-frontmatter": "^5.0.0",
		"solid-js": "^1.9.13",
		"svelte": "^5.56.4",
		"terser": "^5.48.0",
		"to-vfile": "^8.0.0",
		"typescript": "~6.0.3",
		"vfile-matter": "^5.0.1",
		"vite": "^8.1.0"
	},
	"dependencies": {
		"@mdi/js": "^7.4.47",
		"@rollup/browser": "^4.62.2",
		"dreamland": "workspace:*",
		"monaco-editor": "^0.55.1"
	}
}
