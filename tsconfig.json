{
	"compilerOptions": {
		"lib": ["ES2022", "dom", "dom.iterable"],
		"target": "ES2022",
		"declaration": true,
		"declarationDir": "dist/types",
		"rootDir": "src",
		"moduleResolution": "bundler",
		"stripInternal": true,
		"strict": true,
		"allowUnusedLabels": true,

		// subpackages import core as "dreamland/core", which package.json exports
		// resolves to dist/core.d.ts -- so without this they typecheck against the
		// *last build* and core's `declare global { namespace JSX }` gets declared
		// twice in one program. rollup marks dreamland/core external by name, so
		// this only affects typechecking, not what ends up in the bundles
		"paths": { "dreamland/*": ["./src/*"] }
	},
	"include": ["src"],
	"exclude": ["dist"]
}
